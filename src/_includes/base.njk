<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# =========================================================================
     SEO META TAGS
     Page title and description are set in each page's front matter.
     Fallbacks use global values from src/_data/site.json.
     ========================================================================= #}
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} | {{ site.title }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}" />

  {# Open Graph tags — improve link previews on social media #}
  <meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}" />
  <meta property="og:type" content="{{ site.open_graph.type }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ site.open_graph.image }}" />

  {# Canonical URL for SEO #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  {# =========================================================================
     FONTS — loaded from Google Fonts
     Inter: clean modern body font
     Playfair Display: elegant serif for headings
     To change fonts, update the link href below AND update CSS variables
     in src/assets/css/style.css
     ========================================================================= #}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

  {# =========================================================================
     MAIN STYLESHEET
     All styles are in src/assets/css/style.css
     ========================================================================= #}
  <link rel="stylesheet" href="/assets/css/style.css" />

  {# Favicon — place a favicon.ico or favicon.png in src/assets/images/ #}
  {# <link rel="icon" href="/assets/images/favicon.png" type="image/png" /> #}
</head>

<body class="{% if page.url == '/' %}page-home{% else %}page-inner{% endif %}">

  {# =========================================================================
     TOP NAVIGATION BAR
     Shown on all pages including the home page.
     Active page is highlighted via the 'active' class — Eleventy's page.url
     is used to detect which nav link matches the current page.
     ========================================================================= #}
  <header class="site-header">
    <nav class="top-nav" aria-label="Main navigation">

      {# Site name / logo — links back to home #}
      <a href="/" class="nav-logo">{{ site.name }}</a>

      {# Hamburger button — visible only on mobile, toggles .nav-open class #}
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>

      {# Navigation links — update this list if you add/remove pages #}
      <ul class="nav-links">
        <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Home</a></li>
        <li><a href="/publications/" {% if page.url == "/publications/" %}class="active"{% endif %}>Publications</a></li>
        <li><a href="/projects/" {% if page.url == "/projects/" %}class="active"{% endif %}>Projects</a></li>
        <li><a href="/research/" {% if page.url == "/research/" %}class="active"{% endif %}>Research</a></li>
        <li><a href="/teaching/" {% if page.url == "/teaching/" %}class="active"{% endif %}>Teaching</a></li>
        <li><a href="/blog/" {% if page.url == "/blog/" or page.url.startsWith("/blog/") %}class="active"{% endif %}>Blog</a></li>
        <li><a href="/contact/" {% if page.url == "/contact/" %}class="active"{% endif %}>Contact</a></li>
      </ul>

    </nav>
  </header>

  {# =========================================================================
     MAIN CONTENT AREA
     The content block is filled in by each individual page template.
     ========================================================================= #}
  <main id="main-content">
    {{ content | safe }}
  </main>

  {# =========================================================================
     FOOTER
     Simple footer with copyright and social links.
     Social URLs come from src/_data/site.json
     ========================================================================= #}
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-copy">
        &copy; {{ site.name }} 2026.
      </p>
      <nav class="footer-social" aria-label="Social links">
        <a href="mailto:{{ site.contact.email_university }}" aria-label="Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
        {% if site.social.orcid and "#PLACEHOLDER" not in site.social.orcid %}
        <a href="{{ site.social.orcid }}" target="_blank" rel="noopener" aria-label="ORCID">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm-1.24 5.28h2.48v3.12h-2.48V5.28zm0 5.28h2.48V18.72h-2.48V10.56zm-3.84-5.28c.672 0 1.2.528 1.2 1.2S7.592 7.68 6.92 7.68s-1.2-.528-1.2-1.2.528-1.2 1.2-1.2zm-.84 5.28h1.68V18.72H6.08V10.56z"/></svg>
        </a>
        {% endif %}
        {% if site.social.google_scholar and "#PLACEHOLDER" not in site.social.google_scholar %}
        <a href="{{ site.social.google_scholar }}" target="_blank" rel="noopener" aria-label="Google Scholar">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 10a8 8 0 0 1 7.162 3.44L24 9.5z"/></svg>
        </a>
        {% endif %}
        {% if site.social.researchgate and "#PLACEHOLDER" not in site.social.researchgate %}
        <a href="{{ site.social.researchgate }}" target="_blank" rel="noopener" aria-label="ResearchGate">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="currentColor"/><text x="10" y="74" font-family="Georgia, serif" font-size="62" font-weight="bold" fill="white">R</text><text x="56" y="46" font-family="Georgia, serif" font-size="30" font-weight="bold" fill="white">G</text></svg>
        </a>
        {% endif %}
      </nav>
    </div>
  </footer>

  {# =========================================================================
     JAVASCRIPT
     Minimal vanilla JS — only used for the mobile hamburger menu toggle.
     No frameworks or libraries required.
     ========================================================================= #}
  <script>
    // Mobile navigation toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    if (navToggle && navLinks) {
      navToggle.addEventListener('click', function () {
        const isOpen = navLinks.classList.toggle('nav-open');
        navToggle.setAttribute('aria-expanded', isOpen);
      });
      // Close menu when a link is clicked (on mobile)
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('nav-open');
          navToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>

</body>
</html>
