---
layout: base.njk
title: Contact
description: "Contact Dr. Carolina Recart at the University of Strathclyde, Glasgow."
---
{# =========================================================================
   CONTACT PAGE (src/contact.njk)
   Contact details come from src/_data/site.json → "contact" and "social"

   The contact form has been removed per feedback. Only the "Get in Touch"
   info is shown, centred on the page.
   To re-add the form in future, see the git history for the Formspree setup.
   ========================================================================= #}

<header class="page-header">
  <div class="page-header-inner">
    <h1>Contact</h1>
    <p>Get in touch for research collaborations, speaking invitations, or general enquiries</p>
  </div>
</header>

<div class="contact-centered">

  <section class="contact-info-centered" aria-labelledby="contact-info-heading">
    <h2 id="contact-info-heading">Get in Touch</h2>

    {# University email only — personal email removed per feedback #}
    <div class="contact-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      <div>
        <span class="contact-label">Email</span>
        <a href="mailto:{{ site.contact.email_university }}">{{ site.contact.email_university }}</a>
      </div>
    </div>

    {# Address #}
    <div class="contact-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <span class="contact-label">Address</span>
        <address style="font-style: normal;">{{ site.contact.address }}</address>
      </div>
    </div>

    {# Social profiles — shown as a horizontal row of links #}
    <div class="contact-social-row">

      {% if site.social.orcid and "#PLACEHOLDER" not in site.social.orcid %}
      <a href="{{ site.social.orcid }}" target="_blank" rel="noopener" class="contact-social-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm-1.24 5.28h2.48v3.12h-2.48V5.28zm0 5.28h2.48V18.72h-2.48V10.56zm-3.84-5.28c.672 0 1.2.528 1.2 1.2S7.592 7.68 6.92 7.68s-1.2-.528-1.2-1.2.528-1.2 1.2-1.2zm-.84 5.28h1.68V18.72H6.08V10.56z"/></svg>
        ORCID
      </a>
      {% endif %}

      {% if site.social.google_scholar and "#PLACEHOLDER" not in site.social.google_scholar %}
      <a href="{{ site.social.google_scholar }}" target="_blank" rel="noopener" class="contact-social-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 10a8 8 0 0 1 7.162 3.44L24 9.5z"/></svg>
        Google Scholar
      </a>
      {% endif %}

      {% if site.social.researchgate and "#PLACEHOLDER" not in site.social.researchgate %}
      <a href="{{ site.social.researchgate }}" target="_blank" rel="noopener" class="contact-social-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="currentColor"/><text x="10" y="74" font-family="Georgia, serif" font-size="62" font-weight="bold" fill="white">R</text><text x="56" y="46" font-family="Georgia, serif" font-size="30" font-weight="bold" fill="white">G</text></svg>
        ResearchGate
      </a>
      {% endif %}

    </div>

  </section>

</div>
